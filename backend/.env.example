# National Rural Enterprise Intelligence Platform (NREIP) Environment Configuration
PROJECT_NAME="National Rural Enterprise Intelligence Platform"
VERSION="1.2.0"
ENVIRONMENT="production"

# Database Configuration (SQLite default / PostgreSQL ready)
DATABASE_URL="sqlite:///./rural_enterprise.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/rural_enterprise"

# Redis Cache Backplane (Optional - in-memory fallback engages automatically if omitted)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Supabase Auth / JWT Configuration
SUPABASE_URL="https://mock.supabase.co"
SUPABASE_KEY="demo_anon_key"
SUPABASE_JWT_SECRET="sih_rural_intelligence_jwt_super_secret_key_2026_secure"

# AI Inference Layer (Groq Llama 3.3 primary + Gemini fallback)
# Free-tier keys supported. If absent, high-performance deterministic engine takes over seamlessly.
GROQ_API_KEY="gsk_demo_groq_llama_key_replace_if_available"
GEMINI_API_KEY="demo_gemini_api_key_replace_if_available"

# SMS Gateway (Dev mode bypasses real SMS cost: uses fixed demo OTP 123456)
SMS_DEV_MODE=True
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
